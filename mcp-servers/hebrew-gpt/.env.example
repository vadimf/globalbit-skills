# Copy this file to ".env" and fill in your own OpenAI API key.
# Each colleague uses their OWN key — never share keys.
# On macOS the installer stores the key in Keychain instead, so .env is optional there.

OPENAI_API_KEY=sk-proj-your-own-key-here

# Optional: override the default model (gpt-5.5)
# HEBREW_GPT_MODEL=gpt-5.5-pro
